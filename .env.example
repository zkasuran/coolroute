# Cool Route Planner configuration. Copy to .env and fill in.

# --- FortyGuard Temperature API ---
# Which backend the adapter uses: "mock" (offline, synthetic, labelled) or "live".
FORTYGUARD_BACKEND=mock
# Real API base. Leave as-is; the live key is emailed after registration.
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1
# Your FortyGuard key (sent in the `api-key` request header). Blank until issued.
FORTYGUARD_API_KEY=

# --- Agent reasoning model ---
# A top-tier OpenAI model over an OpenAI-compatible endpoint.
# These use the standard OpenAI SDK variable names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
